# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  HalluCheck v4 — 100% FREE configuration                                   ║
# ║  No paid API keys required. All services run locally or use free APIs.      ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ── LLM Provider ─────────────────────────────────────────────────────────────
# ollama = free, local inference  |  install: https://ollama.com
LLM_PROVIDER=ollama

# ── Ollama — LOCAL FREE LLM ───────────────────────────────────────────────────
# Install models: ollama pull llama3.1:8b
# RTX 3050 4 GB: llama3.1:8b fits comfortably (~1.5-2 s inference)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_VERIFIER_MODEL=llama3.1:8b
EXTRACTOR_MODEL=phi3:mini
VERIFIER_MODEL=llama3.1:8b

# ── NLI — FREE LOCAL MODEL ────────────────────────────────────────────────────
# DeBERTa-v3-large runs entirely on your GPU/CPU, no network calls
NLI_ENABLED=true
NLI_MODEL=cross-encoder/nli-deberta-v3-large
NLI_CONFIDENCE_THRESHOLD=0.55

# Fast / NLI-only mode — verified ~2-4 s with zero LLM cost
# Set FAST_MODE=true to skip LLM entirely (DeBERTa-v3 NLI + web search only)
NLI_ONLY_MODE=false
FAST_MODE=false

# ── Web Evidence — FREE (Wikipedia + DuckDuckGo, no API key needed) ───────────
# TAVILY_API_KEY intentionally left blank — DuckDuckGo + Wikipedia used instead
TAVILY_API_KEY=
WEB_RAG_ENABLED=true
WEB_RAG_KB_THRESHOLD=0.25

# ── Paid API keys — ALL BLANK (not needed) ───────────────────────────────────
ANTHROPIC_API_KEY=
NVIDIA_NIM_API_KEY=
TOGETHER_API_KEY=
FALLBACK_ENABLED=false
ENSEMBLE_FOR_CRITICAL=false

# ── Security — CHANGE THESE in production ────────────────────────────────────
API_KEY=change-me-in-production
ADMIN_KEY=change-admin-key-in-production
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW=60

# ── Proxy Server ─────────────────────────────────────────────────────────────
PROXY_HOST=0.0.0.0
PROXY_PORT=8080

# ── Detection Thresholds ─────────────────────────────────────────────────────
BLOCK_THRESHOLD=0.50
FLAG_THRESHOLD=0.60

# ── Knowledge Base (ChromaDB — free, local) ──────────────────────────────────
KB_PERSIST_DIR=./chroma_db
KB_COLLECTION_NAME=authoritative_docs
KB_TOP_K=5
KB_MIN_RELEVANCE=0.28
KB_CHUNK_SIZE=512
KB_CHUNK_OVERLAP=64

# ── Features ─────────────────────────────────────────────────────────────────
HYDE_ENABLED=false
BM25_ENABLED=false
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_ENABLED=true
SELF_CORRECTION_ENABLED=true
STREAMING_ENABLED=true
MPC_ENABLED=false
MPC_CANDIDATES=3
MPC_MAX_SENTENCES=10

# ── Redis (optional — in-memory fallback used if not set) ────────────────────
REDIS_URL=redis://localhost:6379

# ── Wikipedia auto-seed (free — seeds ChromaDB KB on first startup) ──────────
WIKI_AUTO_SEED_ENABLED=true
WIKI_AUTO_SEED_THRESHOLD=5000

# ── HMM / Reward / Coref ─────────────────────────────────────────────────────
HMM_ENABLED=true
REWARD_SYSTEM_ENABLED=true
COREF_ENABLED=true

# ── Audit ─────────────────────────────────────────────────────────────────────
AUDIT_LOG_PATH=./audit_trail.jsonl

# ── Runtime ──────────────────────────────────────────────────────────────────
MAX_WORKERS=4
REQUEST_TIMEOUT=60.0
LOG_LEVEL=INFO
